<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--color-surface-low, #f5f3f3);flex-direction:column;gap:8px;color:var(--color-text-medium, #888)">
  <span class="material-symbols-outlined" style="font-size:{{ icon_size | default: 48 }}px;color:var(--color-border, #ddd)">{{ icon | default: 'image' }}</span>
  {%- if caption != blank -%}
    <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em">{{ caption }}</span>
  {%- endif -%}
</div>