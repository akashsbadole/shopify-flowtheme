{%- unless request.page_type == 'index' -%}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <span class="breadcrumbs__item"><a href="{{ routes.root_url }}">Home</a></span>
  {%- if request.page_type == 'collection' -%}
    <span class="breadcrumbs__item">{{ collection.title }}</span>
  {%- elsif request.page_type == 'product' -%}
    {%- if collection -%}
      <span class="breadcrumbs__item"><a href="{{ collection.url }}">{{ collection.title }}</a></span>
    {%- endif -%}
    <span class="breadcrumbs__item">{{ product.title }}</span>
  {%- elsif request.page_type == 'blog' -%}
    <span class="breadcrumbs__item">{{ blog.title }}</span>
  {%- elsif request.page_type == 'article' -%}
    <span class="breadcrumbs__item"><a href="{{ blog.url }}">{{ blog.title }}</a></span>
    <span class="breadcrumbs__item">{{ article.title }}</span>
  {%- elsif request.page_type == 'page' -%}
    <span class="breadcrumbs__item">{{ page.title }}</span>
  {%- endif -%}
</nav>
{%- endunless -%}
