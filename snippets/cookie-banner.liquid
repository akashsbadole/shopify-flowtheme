  <div style="flex:1">
    <p style="font-size:14px;font-weight:600;margin-bottom:6px">Cookie Preferences</p>
    <p style="font-size:13px;color:var(--color-text-medium);line-height:1.5;margin-bottom:14px">We use cookies to improve your experience. By continuing, you agree to our <a href="/pages/privacy-policy" style="color:var(--color-primary)">Privacy Policy</a>.</p>
