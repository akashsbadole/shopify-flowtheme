<div class="cookie-banner" style="position:fixed;bottom:24px;left:24px;right:24px;max-width:480px;background:white;border:1px solid var(--color-border);border-radius:8px;padding:20px;box-shadow:0 8px 32px rgba(0,0,0,0.12);z-index:500;display:flex;gap:16px;align-items:flex-start">
