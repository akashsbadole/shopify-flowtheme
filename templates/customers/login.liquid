<div class="section">
  <div class="container" style="max-width:440px">
    <div style="text-align:center;margin-bottom:40px">
      <a href="{{ routes.root_url }}" class="header__logo" style="display:inline-block;margin-bottom:24px">{{ shop.name }}</a>
      <h1 class="text-h2">Welcome back</h1>
      <p style="color:var(--color-text-medium);margin-top:8px">Sign in to your account</p>
    </div>
    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div style="padding:16px;background:#fef2f2;border:1px solid #fecaca;border-radius:4px;color:#dc2626;font-size:14px;margin-bottom:20px">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="form-field">
        <label class="form-label" for="customer-email">Email</label>
        <input class="form-input" type="email" name="customer[email]" id="customer-email" autocomplete="email" autocapitalize="off" required>
      </div>
      <div class="form-field" style="margin-top:16px">
        <label class="form-label" for="customer-password" style="display:flex;justify-content:space-between;align-items:center">
          Password
          <a href="{{ routes.root_url }}account/login#recover" style="font-size:12px;color:var(--color-primary);font-weight:500;text-transform:none;letter-spacing:0">Forgot password?</a>
        </label>
        <input class="form-input" type="password" name="customer[password]" id="customer-password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full btn--lg" style="margin-top:24px">Sign In</button>
    {%- endform -%}
    <p style="text-align:center;margin-top:24px;font-size:14px;color:var(--color-text-medium)">
      Don't have an account?
      <a href="{{ routes.account_register_url }}" style="color:var(--color-primary);font-weight:700">Create one</a>
    </p>
  </div>
</div>
