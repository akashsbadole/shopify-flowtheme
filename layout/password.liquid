<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Coming Soon</title>
  {{ 'fonts.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <style>
    body { background:#18181b;color:white;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;font-family:'Plus Jakarta Sans',sans-serif;padding:24px }
    .password-logo { font-size:32px;font-weight:900;letter-spacing:-0.04em;margin-bottom:48px }
    .password-title { font-size:clamp(36px,7vw,80px);font-weight:900;letter-spacing:-0.04em;line-height:0.95;margin-bottom:20px }
    .password-sub { font-size:18px;color:rgba(255,255,255,0.6);margin-bottom:48px;max-width:480px }
    .password-form { display:flex;gap:0;width:100%;max-width:440px;margin:0 auto }
    .password-form input { flex:1;padding:16px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-right:none;border-radius:4px 0 0 4px;color:white;font-size:16px;font-family:inherit;outline:none }
    .password-form input::placeholder { color:rgba(255,255,255,0.35) }
    .password-form button { padding:16px 24px;background:#0052FF;color:white;border:none;border-radius:0 4px 4px 0;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap }
    .password-admin { position:fixed;bottom:24px;right:24px;font-size:13px;color:rgba(255,255,255,0.3) }
    .password-admin a { color:rgba(255,255,255,0.5) }
  </style>
</head>
<body>
  <div class="password-logo">{{ shop.name }}</div>
  <h1 class="password-title">We're almost<br>ready.</h1>
  <p class="password-sub">Our store is under construction. Subscribe to be the first to know when we launch.</p>

  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,presale">
    <div class="password-form">
      <input type="email" name="contact[email]" placeholder="Your email address" required autocomplete="email">
      <button type="submit">Notify Me</button>
    </div>
    {%- if form.posted_successfully? -%}
      <p style="margin-top:16px;color:#4ade80;font-size:14px">✓ Thank you! We'll be in touch.</p>
    {%- endif -%}
  {%- endform -%}

  {{ content_for_layout }}

  <div class="password-admin">
    <a href="/password">Admin Access</a>
  </div>
</body>
</html>
