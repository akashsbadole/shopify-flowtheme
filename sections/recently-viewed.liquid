{%- comment -%}Recently Viewed Products Section{%- endcomment -%}
<section class="section" style="background:var(--color-surface-low);padding:60px 0">
  <div class="container">
    <div class="section-header" style="margin-bottom:32px;text-align:center">
      <h2 class="section-header__title">{{ section.settings.title }}</h2>
    </div>
    <div id="recently-viewed-grid" class="product-grid product-grid--{{ section.settings.columns }}" style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px">
      <div style="grid-column:1/-1;text-align:center;padding:40px">
        <span class="material-symbols-outlined" style="font-size:40px;color:var(--color-border)">visibility</span>
        <p style="margin-top:12px;color:var(--color-text-medium)">No recently viewed products yet</p>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  const STORAGE_KEY = 'flowtheme_recently_viewed';
  const MAX_ITEMS = {{ section.settings.limit }};
  const grid = document.getElementById('recently-viewed-grid');

  function loadRecentlyViewed() {
    const handles = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]').slice(0, MAX_ITEMS);
    if (handles.length === 0) return;

    grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px"><span class="material-symbols-outlined" style="font-size:32px;color:var(--color-border)">autorenew</span></div>';

    Promise.all(handles.map(h => fetch(`/products/${h}.js`).then(r => r.ok ? r.json() : null).catch(() => null)))
      .then(products => {
        const valid = products.filter(p => p);
        if (valid.length === 0) {
          grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px"><p>No products found</p></div>';
          return;
        }
        
        grid.innerHTML = valid.map(p => {
          const price = p.price ? (p.price / 100).toLocaleString('en-US',{style:'currency',currency:'{{ cart.currency.iso_code }}'}) : '';
          const image = (typeof p.featured_image === 'string' && p.featured_image) 
            ? p.featured_image 
            : (p.featured_image && p.featured_image.src) 
              ? p.featured_image.src 
              : (p.images && p.images[0]) 
                ? (typeof p.images[0] === 'string' ? p.images[0] : p.images[0].src) 
                : '';
          const variantId = (p.variants && p.variants[0]) ? p.variants[0].id : (p.id || 0);
          const productUrl = p.url || '/products/product';
          const title = p.title || 'Product';
          const vendor = p.vendor || '';
          const priceFormatted = price || '$0.00';
          const imgTag = image 
            ? `<img src="${image}" alt="${title}" loading="lazy" style="width:100%;height:100%;object-fit:cover">`
            : `<div style="display:flex;align-items:center;justify-content:center;height:100%;background:#e2e8f0"><span class="material-symbols-outlined" style="font-size:32px;color:#94a3b8">image</span></div>`;
          
          return `<article class="product-card" style="border:1px solid var(--color-border);border-radius:12px;overflow:hidden">
            <div class="product-card__media" style="aspect-ratio:3/4;background:#f5f5f5">
              <a href="${productUrl}">${imgTag}</a>
            </div>
            <div class="product-card__info" style="padding:16px">
              <p class="product-card__vendor" style="font-size:11px;color:var(--color-text-medium);text-transform:uppercase;margin-bottom:4px">${vendor}</p>
              <a href="${productUrl}" class="product-card__title" style="font-size:14px;font-weight:600;color:var(--color-text-high);text-decoration:none;display:block;margin-bottom:8px">${title}</a>
              <span class="product-card__price" style="font-size:16px;font-weight:700;color:var(--color-primary)">${priceFormatted}</span>
              <button onclick="quickAddToCart(${variantId}, '${title.replace(/'/g, "\\'")}')" style="margin-top:12px;width:100%;padding:10px;background:var(--color-primary);color:#fff;border:none;border-radius:6px;cursor:pointer">Add to Cart</button>
            </div>
          </article>`;
        }).join('');
      })
      .catch(err => {
        console.error('Error loading recently viewed:', err);
        grid.innerHTML = '';
      });
  }

  document.addEventListener('DOMContentLoaded', loadRecentlyViewed);
})();
</script>

{% schema %}
{
  "name": "Recently Viewed",
  "settings": [
    {"type": "text", "id": "title", "label": "Title", "default": "Recently Viewed"},
    {"type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 2, "default": 4},
    {"type": "select", "id": "columns", "label": "Columns", "default": "4", "options": [{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}]}
  ],
  "presets": [{"name": "Recently Viewed"}]
}
{% endschema %}