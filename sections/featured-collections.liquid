<section class="section" style="background:var(--color-surface)">
  <div class="container">
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.title | default: 'Featured Collections' }}</h2>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="section-header__link">
          View All <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span>
        </a>
      {%- endif -%}
    </div>
    <div style="display:grid;grid-template-columns:repeat({{ section.settings.columns | default: 3 }},1fr);gap:24px">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection' -%}
          {%- assign col = collections[block.settings.collection] -%}
          {%- if col != blank -%}
          <a href="{{ col.url }}" class="group" style="display:block;position:relative;overflow:hidden;border-radius:4px;aspect-ratio:3/4;background:var(--color-surface-low)" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank or col.image != blank -%}
              {%- assign img_url = block.settings.image | default: col.image -%}
              {%- assign img_alt = block.settings.label | default: col.title -%}
              <img src="{{ img_url | image_url: width: 800 }}" alt="{{ img_alt }}" width="800" height="1067" loading="lazy" style="width:100%;height:100%;object-fit:cover;transition:transform 0.6s ease">
              <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.6) 0%,transparent 50%);pointer-events:none"></div>
              <div style="position:absolute;bottom:28px;left:24px;right:24px;color:white">
                <h3 style="font-size:22px;font-weight:800;letter-spacing:-0.02em;margin-bottom:4px">{{ block.settings.label | default: col.title }}</h3>
                {%- if block.settings.subtitle != blank -%}
                  <p style="font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;opacity:0.75">{{ block.settings.subtitle }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
              {%- render 'image-placeholder', fallback: 'centered', icon: 'collections', icon_size: 48, caption: block.settings.label | default: col.title, fallback_icon: 'collections', fallback_caption: block.settings.label | default: col.title -%}
              {%- if block.settings.subtitle != blank and settings.show_demo_placeholders == false -%}
                <div style="position:absolute;bottom:28px;left:24px;right:24px">
                  <p style="font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-text-medium)">{{ block.settings.subtitle }}</p>
                </div>
              {%- endif -%}
            {%- endif -%}
          </a>
          {%- else -%}
          <a href="{{ block.settings.collection | default: '/collections/all' | escape }}" class="group" style="display:block;position:relative;overflow:hidden;border-radius:4px;aspect-ratio:3/4;background:var(--color-surface-low)" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.label | escape }}" width="800" height="1067" loading="lazy" style="width:100%;height:100%;object-fit:cover;transition:transform 0.6s ease">
              <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.6) 0%,transparent 50%);pointer-events:none"></div>
              <div style="position:absolute;bottom:28px;left:24px;right:24px;color:white">
                <h3 style="font-size:22px;font-weight:800;letter-spacing:-0.02em;margin-bottom:4px">{{ block.settings.label | default: 'Shop Collection' }}</h3>
                {%- if block.settings.subtitle != blank -%}
                  <p style="font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;opacity:0.75">{{ block.settings.subtitle }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
              <div style="display:flex;align-items:center;justify-content:center;height:100%;background:linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div style="text-align:center;color:white;padding:24px">
                  <span class="material-symbols-outlined" style="font-size:48px;margin-bottom:16px;display:block">collections</span>
                  <h3 style="font-size:22px;font-weight:800;letter-spacing:-0.02em;margin-bottom:4px">{{ block.settings.label | default: 'Shop Collection' }}</h3>
                  {%- if block.settings.subtitle != blank -%}
                    <p style="font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;opacity:0.75">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {"type":"text","id":"title","label":"Section Title","default":"Featured Collections"},
    {"type":"url","id":"view_all_link","label":"View All Link"},
    {"type":"range","id":"columns","min":2,"max":4,"step":1,"label":"Columns","default":3}
  ],
  "blocks":[
    {"type":"collection","name":"Collection","settings":[
      {"type":"collection","id":"collection","label":"Collection (Optional)"},
      {"type":"image_picker","id":"image","label":"Override Image"},
      {"type":"text","id":"label","label":"Label","default":"Shop Collection"},
      {"type":"text","id":"subtitle","label":"Subtitle"}
    ]}
  ],
  "max_blocks":8,
  "presets":[{"name":"Featured Collections","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]
}
{% endschema %}
