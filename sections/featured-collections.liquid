<section class="section" style="background:var(--color-surface)">
  <div class="container">
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.title | default: 'Featured Collections' }}</h2>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="section-header__link">
          View All <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span>
        </a>
      {%- endif -%}
    </div>
    <div style="display:grid;grid-template-columns:repeat({{ section.settings.columns | default: 3 }},1fr);gap:24px">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection' and block.settings.collection != blank -%}
          {%- assign col = collections[block.settings.collection] -%}
          {%- if col != blank -%}
          <a href="{{ col.url }}" class="group" style="display:block;position:relative;overflow:hidden;border-radius:4px;aspect-ratio:3/4;background:var(--color-surface-low)" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.label | default: col.title }}" width="800" height="1067" loading="lazy" style="width:100%;height:100%;object-fit:cover;transition:transform 0.6s ease">
            {%- elsif col.image -%}
              <img src="{{ col.image | image_url: width: 800 }}" alt="{{ col.title }}" width="800" height="1067" loading="lazy" style="width:100%;height:100%;object-fit:cover;transition:transform 0.6s ease">
            {%- endif -%}
            <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.6) 0%,transparent 50%);pointer-events:none"></div>
            <div style="position:absolute;bottom:28px;left:24px;right:24px;color:white">
              <h3 style="font-size:22px;font-weight:800;letter-spacing:-0.02em;margin-bottom:4px">{{ block.settings.label | default: col.title }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <p style="font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;opacity:0.75">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {"type":"text","id":"title","label":"Section Title","default":"Featured Collections"},
    {"type":"url","id":"view_all_link","label":"View All Link"},
    {"type":"range","id":"columns","min":2,"max":4,"step":1,"label":"Columns","default":3}
  ],
  "blocks":[
    {"type":"collection","name":"Collection","settings":[
      {"type":"collection","id":"collection","label":"Collection"},
      {"type":"image_picker","id":"image","label":"Override Image"},
      {"type":"text","id":"label","label":"Label"},
      {"type":"text","id":"subtitle","label":"Subtitle"}
    ]}
  ],
  "max_blocks":8,
  "presets":[{"name":"Featured Collections","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]
}
{% endschema %}
