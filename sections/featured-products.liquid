<section class="section" style="background:{{ section.settings.background }}">
  <div class="container">
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.title }}</h2>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="section-header__link">
          View All <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span>
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.description != blank -%}
      <p style="font-size:16px;color:var(--color-text-medium);margin-top:-24px;margin-bottom:32px;max-width:560px">{{ section.settings.description }}</p>
    {%- endif -%}
    <div class="product-grid product-grid--{{ section.settings.columns }}">
      {%- assign has_products = false -%}
      {%- if section.settings.collection != blank -%}
        {%- assign collection = collections[section.settings.collection] -%}
        {%- for product in collection.products limit: section.settings.product_limit -%}
          {%- render 'product-card', product: product -%}
          {%- assign has_products = true -%}
        {%- endfor -%}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'product' -%}
            {%- if block.settings.product != blank -%}
              {%- render 'product-card', product: block.settings.product -%}
              {%- assign has_products = true -%}
            {%- endif -%}
          {%- when 'collection' -%}
            {%- assign col = collections[block.settings.collection] -%}
            {%- if col != blank -%}
              {%- for product in col.products limit: block.settings.limit -%}
                {%- render 'product-card', product: product -%}
                {%- assign has_products = true -%}
              {%- endfor -%}
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
      {%- unless has_products -%}
        {%- if section.settings.show_demo_products -%}
          {%- for i in (1..8) -%}
            {%- render 'product-card-placeholder' -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endunless -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Primary Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products from primary collection",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Number of columns on desktop",
      "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_demo_products",
      "label": "Show placeholder products when empty",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Individual Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    },
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "limit",
          "label": "Products to show",
          "min": 1,
          "max": 8,
          "step": 1,
          "default": 4
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Featured Products",
      "category": "Products"
    }
  ]
}
{% endschema %}