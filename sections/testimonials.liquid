<section class="section" style="background:{{ section.settings.background | default: 'var(--color-surface-low)' }}">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px">
      <h2 class="section-header__title">{{ section.settings.title | default: 'What Our Customers Say' }}</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat({{ section.settings.columns | default: 3 }},1fr);gap:24px">
      {%- for block in section.blocks -%}
        <div style="background:white;border:1px solid var(--color-border);border-radius:8px;padding:28px" {{ block.shopify_attributes }}>
          <div style="display:flex;gap:3px;margin-bottom:16px;color:#f59e0b">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}
                <span class="material-symbols-outlined fill" style="font-size:18px">star</span>
              {%- else -%}
                <span class="material-symbols-outlined" style="font-size:18px">star</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if block.settings.title != blank -%}
            <p style="font-size:16px;font-weight:700;margin-bottom:10px;color:var(--color-text-high)">{{ block.settings.title }}</p>
          {%- endif -%}
          <p style="font-size:14px;line-height:1.7;color:var(--color-text-medium);margin-bottom:20px">{{ block.settings.review }}</p>
          <div style="display:flex;align-items:center;gap:12px">
            {%- if block.settings.avatar != blank -%}
              <img src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.author }}" width="40" height="40" style="width:40px;height:40px;border-radius:50%;object-fit:cover">
            {%- else -%}
              <div style="width:40px;height:40px;border-radius:50%;background:var(--color-primary);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:16px">{{ block.settings.author | slice: 0 }}</div>
            {%- endif -%}
            <div>
              <p style="font-size:14px;font-weight:700;color:var(--color-text-high)">{{ block.settings.author }}</p>
              {%- if block.settings.location != blank -%}
                <p style="font-size:12px;color:var(--color-text-medium)">{{ block.settings.location }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.verified -%}
              <span style="margin-left:auto;font-size:11px;font-weight:600;color:var(--color-success);display:flex;align-items:center;gap:3px">
                <span class="material-symbols-outlined fill" style="font-size:14px">verified</span>Verified
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {"type":"text","id":"title","label":"Section Title","default":"What Our Customers Say"},
    {"type":"select","id":"columns","label":"Columns","default":"3","options":[{"value":"1","label":"1"},{"value":"2","label":"2"},{"value":"3","label":"3"}]},
    {"type":"color","id":"background","label":"Background","default":"#f5f3f3"}
  ],
  "blocks":[
    {"type":"testimonial","name":"Testimonial","settings":[
      {"type":"range","id":"rating","min":1,"max":5,"step":1,"label":"Rating","default":5},
      {"type":"text","id":"title","label":"Review Title"},
      {"type":"textarea","id":"review","label":"Review Text","default":"Absolutely love this product! Quality is exceptional and delivery was super fast."},
      {"type":"text","id":"author","label":"Author Name","default":"Sarah M."},
      {"type":"text","id":"location","label":"Location"},
      {"type":"image_picker","id":"avatar","label":"Avatar"},
      {"type":"checkbox","id":"verified","label":"Verified Purchase","default":true}
    ]}
  ],
  "max_blocks":9,
  "presets":[{"name":"Testimonials"}]
}
{% endschema %}
