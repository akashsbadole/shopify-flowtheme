<section class="section" style="padding-top:40px;padding-bottom:80px">
  <div class="container" style="max-width:800px">
    <div class="breadcrumbs">
      <span class="breadcrumbs__item"><a href="{{ routes.root_url }}">Home</a></span>
      <span class="breadcrumbs__item">{{ page.title }}</span>
    </div>
    <h1 class="text-h1" style="margin-bottom:32px">{{ page.title }}</h1>
    <div class="rte" style="font-size:16px;line-height:1.8;color:var(--color-text-high)">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [],
  "presets": [
    {
      "name": "Page"
    }
  ]
}
{% endschema %}
