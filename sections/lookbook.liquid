<section class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.title | default: 'Shop the Look' }}</h2>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="section-header__link">View All <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span></a>
      {%- endif -%}
    </div>
    <div class="lookbook-grid" style="max-height:700px">
      {%- for block in section.blocks limit: 3 -%}
        <div class="lookbook-item {% if forloop.first %}lookbook-item--large{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.label }}" width="800" height="1067" loading="lazy" style="width:100%;height:100%;object-fit:cover">
          {%- else -%}
            {%- render 'image-placeholder', fallback: 'centered', icon: 'image', icon_size: 48, caption: 'Add image', fallback_icon: 'image', fallback_caption: 'Add image' -%}
          {%- endif -%}
          {%- if block.settings.product_1 != blank -%}
            <div class="lookbook-hotspot" style="top:{{ block.settings.hotspot_1_top | default: 40 }}%;left:{{ block.settings.hotspot_1_left | default: 40 }}%"></div>
          {%- endif -%}
          <div class="shop-the-look-panel">
            <p class="text-label" style="margin-bottom:12px;color:var(--color-text-medium)">{{ block.settings.label | default: 'Shop this look' }}</p>
            {%- if block.settings.product_1 != blank -%}
              {%- assign prod = all_products[block.settings.product_1] -%}
              <div style="display:flex;align-items:center;gap:12px">
                <img src="{{ prod.featured_image | image_url: width: 80 }}" alt="" width="48" height="48" style="width:48px;height:48px;object-fit:cover;border-radius:4px">
                <div style="flex:1">
                  <p style="font-size:13px;font-weight:600">{{ prod.title }}</p>
                  <p style="font-size:13px;color:var(--color-text-medium)">{{ prod.price | money }}</p>
                </div>
                <a href="{{ prod.url }}" class="btn btn--primary btn--sm">Add</a>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"Shop the Look"},
    {"type":"url","id":"link","label":"View All Link"}
  ],
  "blocks":[
    {"type":"look","name":"Look","settings":[
      {"type":"image_picker","id":"image","label":"Image"},
      {"type":"text","id":"label","label":"Label","default":"Shop this look"},
      {"type":"product","id":"product_1","label":"Product"},
      {"type":"range","id":"hotspot_1_top","min":10,"max":90,"step":5,"label":"Hotspot Top %","default":40},
      {"type":"range","id":"hotspot_1_left","min":10,"max":90,"step":5,"label":"Hotspot Left %","default":40}
    ]}
  ],
  "max_blocks":3,
  "presets":[{"name":"Lookbook"}]
}
{% endschema %}
